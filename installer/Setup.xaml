<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Syncro Setup" Width="808" Height="568" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <!-- Syncro design tokens (dark desktop palette) -->
    <SolidColorBrush x:Key="Background" Color="#0B0D12"/>
    <SolidColorBrush x:Key="Sidebar" Color="#0F1218"/>
    <SolidColorBrush x:Key="Surface" Color="#14171F"/>
    <SolidColorBrush x:Key="SurfaceHigh" Color="#1C212C"/>
    <SolidColorBrush x:Key="Outline" Color="#272D39"/>
    <SolidColorBrush x:Key="CardBorder" Color="#CC272D39"/>
    <SolidColorBrush x:Key="Text" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="TextMuted" Color="#9AA3B2"/>
    <SolidColorBrush x:Key="Accent" Color="#8B6CFF"/>
    <SolidColorBrush x:Key="AccentAlt" Color="#19C6FF"/>
    <SolidColorBrush x:Key="AccentWash" Color="#1F8B6CFF"/>
    <SolidColorBrush x:Key="Success" Color="#2DD4A7"/>
    <SolidColorBrush x:Key="SuccessWash" Color="#1F2DD4A7"/>
    <SolidColorBrush x:Key="Danger" Color="#FF6B6B"/>
    <SolidColorBrush x:Key="DangerWash" Color="#1FFF6B6B"/>
    <SolidColorBrush x:Key="BrandMark" Color="#7C5CFF"/>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8B6CFF" Offset="0"/>
      <GradientStop Color="#19C6FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#8B6CFF" Offset="0"/>
      <GradientStop Color="#5B3FD9" Offset="0.5"/>
      <GradientStop Color="#F219C6FF" Offset="1"/>
    </LinearGradientBrush>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- The Syncro mark: two arrows cycling (108-unit box) -->
    <DrawingImage x:Key="Mark">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H108 V108 H0 Z"/>
          <GeometryDrawing Geometry="M25.81,43.74 A30,30 0 0 1 79.98,39.0">
            <GeometryDrawing.Pen><Pen Brush="#7C5CFF" Thickness="9" StartLineCap="Flat" EndLineCap="Flat"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#7C5CFF" Geometry="M87.98,52.86 L89.07,33.75 L70.89,44.25 Z"/>
          <GeometryDrawing Geometry="M82.19,64.26 A30,30 0 0 1 28.02,69.0">
            <GeometryDrawing.Pen><Pen Brush="#7C5CFF" Thickness="9" StartLineCap="Flat" EndLineCap="Flat"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="#7C5CFF" Geometry="M20.02,55.14 L18.93,74.25 L37.11,63.75 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="MarkWhite">
      <DrawingImage.Drawing>
        <DrawingGroup>
          <GeometryDrawing Brush="Transparent" Geometry="M0,0 H108 V108 H0 Z"/>
          <GeometryDrawing Geometry="M25.81,43.74 A30,30 0 0 1 79.98,39.0">
            <GeometryDrawing.Pen><Pen Brush="White" Thickness="9"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="White" Geometry="M87.98,52.86 L89.07,33.75 L70.89,44.25 Z"/>
          <GeometryDrawing Geometry="M82.19,64.26 A30,30 0 0 1 28.02,69.0">
            <GeometryDrawing.Pen><Pen Brush="White" Thickness="9"/></GeometryDrawing.Pen>
          </GeometryDrawing>
          <GeometryDrawing Brush="White" Geometry="M20.02,55.14 L18.93,74.25 L37.11,63.75 Z"/>
        </DrawingGroup>
      </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#1C212C"/>
                <Setter Property="Foreground" Value="#F4F6FB"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChromeClose" TargetType="Button" BasedOn="{StaticResource Chrome}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="7" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#FF6B6B"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Desktop PrimaryButton: 42px, 12px radius, accent brush + 8% white hover veil -->
    <Style x:Key="Primary" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="20,0"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="fill" CornerRadius="12" Background="{StaticResource AccentBrush}"/>
              <Border x:Name="veil" CornerRadius="12" Background="Transparent"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="veil" Property="Background" Value="#14FFFFFF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="fill" Property="Background" Value="#1C212C"/>
                <Setter Property="Foreground" Value="#9AA3B2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource Primary}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border CornerRadius="12" Background="#FF6B6B"/>
              <Border x:Name="veil" CornerRadius="12" Background="Transparent"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="veil" Property="Background" Value="#1AFFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Desktop SecondaryButton: surfaceHigh, hovering to the outline colour -->
    <Style x:Key="Secondary" TargetType="Button">
      <Setter Property="Height" Value="42"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" CornerRadius="12" Background="#1C212C">
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#272D39"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- SyncroSwitch: 52x32, accent track when on, outlined when off -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="track" Width="52" Height="32" CornerRadius="16" Background="#1C212C" BorderBrush="#272D39" BorderThickness="1">
              <Ellipse x:Name="thumb" Width="16" Height="16" Fill="#9AA3B2" HorizontalAlignment="Left" Margin="7,0,0,0"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="#8B6CFF"/>
                <Setter TargetName="track" Property="BorderThickness" Value="0"/>
                <Setter TargetName="thumb" Property="Width" Value="24"/>
                <Setter TargetName="thumb" Property="Height" Value="24"/>
                <Setter TargetName="thumb" Property="Fill" Value="White"/>
                <Setter TargetName="thumb" Property="Margin" Value="24,0,0,0"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Surface}"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
  </Window.Resources>

  <!-- 14px margin leaves room for the window shadow -->
  <Border Margin="14" CornerRadius="12" Background="{StaticResource Background}" BorderBrush="{StaticResource Outline}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" Color="Black"/>
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource Sidebar}" CornerRadius="11,11,0,0">
        <DockPanel Margin="12,0,6,0" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="MinimizeButton" Style="{StaticResource Chrome}" Content="&#xE921;" ToolTip="Minimise"/>
            <Button x:Name="CloseButton" Style="{StaticResource ChromeClose}" Content="&#xE8BB;" ToolTip="Close"/>
          </StackPanel>
          <Image Source="{StaticResource Mark}" Width="15" Height="15" VerticalAlignment="Center"/>
          <TextBlock x:Name="WindowTitle" Text="Syncro Setup" Margin="10,0,0,0" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="264"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Brand panel -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" CornerRadius="0,0,0,11" Padding="22,20,22,22">
          <DockPanel LastChildFill="False">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
              <Image Source="{StaticResource Mark}" Width="32" Height="32"/>
              <TextBlock Text="Syncro" Margin="10,0,0,0" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
            </StackPanel>

            <Border DockPanel.Dock="Top" Margin="0,26,0,0" CornerRadius="28" Background="{StaticResource HeroBrush}" Padding="20">
              <StackPanel>
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" LineHeight="28">Share anything,</TextBlock>
                <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#B8FFFFFF" TextWrapping="Wrap" LineHeight="28">instantly.</TextBlock>
                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#CCFFFFFF" TextWrapping="Wrap" LineHeight="19">Between this PC and your phone — over Wi-Fi, hotspot or Ethernet.</TextBlock>
              </StackPanel>
            </Border>

            <StackPanel DockPanel.Dock="Top" Margin="2,22,0,0">
              <DockPanel Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentWash}">
                  <TextBlock Text="&#xE945;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Full-speed transfers" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock Text="No internet, no size limits" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
              </DockPanel>
              <DockPanel Margin="0,0,0,14">
                <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentWash}">
                  <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="End-to-end encrypted" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock Text="Fresh keys and a PIN every time" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
              </DockPanel>
              <DockPanel>
                <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentWash}">
                  <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="Works with your phone" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock Text="Get Syncro for Android" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
              <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="12" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
              <TextBlock x:Name="VersionText" Text="Version 2.0.0" Margin="6,0,0,0" FontSize="12" FontWeight="Medium" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </StackPanel>
          </DockPanel>
        </Border>

        <!-- Pages -->
        <Grid Grid.Column="1" Margin="32,26,30,24">

          <!-- Welcome / update -->
          <DockPanel x:Name="WelcomePage" LastChildFill="True">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="WelcomeTitle" Text="Install Syncro" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
              <TextBlock x:Name="WelcomeSubtitle" Margin="0,4,0,0" FontSize="15" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="22"
                         Text="Fast, end-to-end encrypted file sharing between this PC and your phone."/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0" LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" x:Name="FooterText" Text="Installs for you only · no admin rights needed" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" x:Name="InstallButton" Style="{StaticResource Primary}" Content="Install" Margin="10,0,0,0" MinWidth="112"/>
              <Button DockPanel.Dock="Right" x:Name="CancelButton" Style="{StaticResource Secondary}" Content="Cancel"/>
            </DockPanel>
            <StackPanel Margin="0,22,0,0">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionLabel}" Text="INSTALL LOCATION"/>
                  <DockPanel>
                    <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentWash}">
                      <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Button DockPanel.Dock="Right" x:Name="ChangeButton" Style="{StaticResource Secondary}" Content="Change" Margin="10,0,0,0"/>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Syncro will be installed in" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock x:Name="PathText" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14,18,8">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionLabel}" Text="OPTIONS"/>
                  <DockPanel Margin="0,0,0,10">
                    <CheckBox DockPanel.Dock="Right" x:Name="DesktopShortcut" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="Desktop shortcut" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock Text="Put Syncro on your desktop as well as the Start menu" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,10">
                    <CheckBox DockPanel.Dock="Right" x:Name="StartWithWindows" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="Start with Windows" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock Text="Wait in the tray, ready to receive from your phone" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                  </DockPanel>
                  <DockPanel Margin="0,0,0,6">
                    <CheckBox DockPanel.Dock="Right" x:Name="LaunchAfter" Style="{StaticResource Switch}" IsChecked="True" VerticalAlignment="Center"/>
                    <StackPanel>
                      <TextBlock Text="Open Syncro when setup finishes" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                      <TextBlock Text="Pair your phone by scanning the QR code" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                  </DockPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </DockPanel>

          <!-- Progress -->
          <DockPanel x:Name="ProgressPage" Visibility="Collapsed" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock x:Name="ProgressTitle" Text="Installing Syncro…" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
              <TextBlock x:Name="ProgressSubtitle" Margin="0,4,0,0" Text="This takes a few seconds." FontSize="15" Foreground="{StaticResource TextMuted}"/>
            </StackPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,40,0,0" Padding="22">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" x:Name="PercentText" Text="0%" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock x:Name="StepText" Text="Preparing" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Margin="0,14,0,0" Height="6">
                  <Border CornerRadius="3" Background="{StaticResource SurfaceHigh}"/>
                  <Border x:Name="ProgressFill" CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" Width="0"/>
                </Grid>
                <TextBlock x:Name="DetailText" Margin="0,12,0,0" FontSize="12" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,18,0,0">
              <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{StaticResource Success}" VerticalAlignment="Center"/>
              <TextBlock Margin="6,0,0,0" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                         Text="Nothing leaves this PC. Syncro has no servers and no accounts."/>
            </StackPanel>
          </DockPanel>

          <!-- Done / removed / error -->
          <DockPanel x:Name="DonePage" Visibility="Collapsed" LastChildFill="False">
            <Border DockPanel.Dock="Top" x:Name="DoneBubble" Width="72" Height="72" CornerRadius="24" Background="{StaticResource SuccessWash}" HorizontalAlignment="Left">
              <TextBlock x:Name="DoneGlyph" Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="30" Foreground="{StaticResource Success}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock DockPanel.Dock="Top" x:Name="DoneTitle" Margin="0,22,0,0" Text="Syncro is ready" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
            <TextBlock DockPanel.Dock="Top" x:Name="DoneBody" Margin="0,6,0,0" FontSize="15" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="22"
                       Text="Find it in the Start menu. Open Syncro on your phone on the same Wi-Fi or hotspot, or scan this PC's QR code."/>
            <Border DockPanel.Dock="Top" x:Name="FirewallCard" Style="{StaticResource Card}" Margin="0,22,0,0">
              <DockPanel>
                <Border Width="36" Height="36" CornerRadius="12" Background="{StaticResource AccentWash}" VerticalAlignment="Top">
                  <TextBlock Text="&#xE83D;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0">
                  <TextBlock Text="Windows Firewall" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="16"
                             Text="The first time Syncro opens, Windows asks whether to allow it. Allow it on private networks so your phone can find this PC (TCP 47821, UDP 47820)."/>
                </StackPanel>
              </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
              <Button DockPanel.Dock="Right" x:Name="FinishButton" Style="{StaticResource Primary}" Content="Finish" MinWidth="112"/>
            </DockPanel>
          </DockPanel>

          <!-- Uninstall -->
          <DockPanel x:Name="UninstallPage" Visibility="Collapsed" LastChildFill="False">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="Remove Syncro?" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
              <TextBlock Margin="0,4,0,0" FontSize="15" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" LineHeight="22"
                         Text="Syncro and its shortcuts will be removed from this PC. Files you've received stay in your Downloads folder."/>
            </StackPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,24,0,0" Padding="18,14">
              <DockPanel>
                <CheckBox DockPanel.Dock="Right" x:Name="RemoveData" Style="{StaticResource Switch}" IsChecked="False" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="Also remove settings and device keys" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                  <TextBlock Text="Trusted devices will need to confirm a PIN again" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <DockPanel DockPanel.Dock="Bottom" LastChildFill="False">
              <Button DockPanel.Dock="Right" x:Name="RemoveButton" Style="{StaticResource DangerButton}" Content="Remove" Margin="10,0,0,0" MinWidth="112"/>
              <Button DockPanel.Dock="Right" x:Name="KeepButton" Style="{StaticResource Secondary}" Content="Cancel"/>
            </DockPanel>
          </DockPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
